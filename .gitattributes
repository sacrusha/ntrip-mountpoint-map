# Default: auto-detect text vs binary; force LF in repo + working tree for text.
# Prevents Python text-mode I/O / editor saves from sneaking CRLF in on Windows.
* text=auto eol=lf

# NTRIP sourcetables: protocol artefacts with CRLF line endings by spec.
# Treat as binary so git never touches them.
*.sourcetable -text

# Explicit binary types
*.png binary
